{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    // The examples import the package by its name, as an application would;
    // here the name resolves to the sources, for the type check and for tsx.
    "paths": {
      "kafka-harbor": ["./src/index.ts"],
      "kafka-harbor/*": ["./src/*/index.ts"]
    }
  },
  "include": ["src", "tests", "examples", "scripts"],
  // The consumer check compiles against dist/ with its own resolution; see
  // tests/consumer/tsconfig.json.
  "exclude": ["tests/consumer", "scripts/doc-snippets.globals.d.ts"]
}
