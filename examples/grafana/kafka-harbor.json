{
  "title": "kafka-harbor",
  "uid": "kafka-harbor",
  "description": "Throughput, outcomes, dead letters, handler latency and consumer lag reported by kafka-harbor/prometheus.",
  "tags": [
    "kafka",
    "kafka-harbor"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kafka_harbor_messages_processed_total, group)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "label": "Consumer group"
      },
      {
        "name": "topic",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kafka_harbor_messages_processed_total{group=~\"$group\"}, topic)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "label": "Topic"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Messages processed per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (group, topic) (rate(kafka_harbor_messages_processed_total{group=~\"$group\", topic=~\"$topic\"}[$__rate_interval]))",
          "legendFormat": "{{group}} {{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Handler failures per second, by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (group, topic, outcome) (rate(kafka_harbor_messages_failed_total{group=~\"$group\", topic=~\"$topic\"}[$__rate_interval]))",
          "legendFormat": "{{group}} {{topic}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Handler latency (p50 / p95 / p99)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, topic) (rate(kafka_harbor_message_processing_duration_seconds_bucket{group=~\"$group\", topic=~\"$topic\"}[$__rate_interval])))",
          "legendFormat": "{{topic}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, topic) (rate(kafka_harbor_message_processing_duration_seconds_bucket{group=~\"$group\", topic=~\"$topic\"}[$__rate_interval])))",
          "legendFormat": "{{topic}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, topic) (rate(kafka_harbor_message_processing_duration_seconds_bucket{group=~\"$group\", topic=~\"$topic\"}[$__rate_interval])))",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Consumer lag per partition",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_harbor_consumer_lag{group=~\"$group\", topic=~\"$topic\"}",
          "legendFormat": "{{group}} {{topic}}[{{partition}}]"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Retries per second, by level",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (group, topic, level) (rate(kafka_harbor_messages_retried_total{group=~\"$group\", topic=~\"$topic\"}[$__rate_interval]))",
          "legendFormat": "{{group}} {{topic}} level {{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Dead letters per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (group, topic) (rate(kafka_harbor_messages_dead_lettered_total{group=~\"$group\", topic=~\"$topic\"}[$__rate_interval]))",
          "legendFormat": "{{group}} {{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Records produced per second, by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic, kind) (rate(kafka_harbor_messages_produced_total{topic=~\"$topic\"}[$__rate_interval]))",
          "legendFormat": "{{topic}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Produce latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, topic) (rate(kafka_harbor_produce_duration_seconds_bucket{topic=~\"$topic\"}[$__rate_interval])))",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Errors per second, by scope",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scope) (rate(kafka_harbor_errors_total[$__rate_interval]))",
          "legendFormat": "{{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Consumer stops (increase over the range)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (group, reason) (increase(kafka_harbor_consumer_stops_total{group=~\"$group\"}[$__range]))",
          "legendFormat": "{{group}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Dead letters in the DLQ (redriven vs dead-lettered, increase over the range)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (increase(kafka_harbor_messages_dead_lettered_total{group=~\"$group\", topic=~\"$topic\"}[$__range]))",
          "legendFormat": "{{topic}} dead-lettered"
        },
        {
          "refId": "B",
          "expr": "sum by (to) (increase(kafka_harbor_messages_redriven_total[$__range]))",
          "legendFormat": "{{to}} redriven"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
